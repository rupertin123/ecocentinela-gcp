{
  "displayName": "EcoCentinela - Operacion",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "width": 6, "height": 4,
        "widget": {
          "title": "Uplinks aceptados (1 foto/hora por nodo, 7-20 h)",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/${uplinks}\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {"alignmentPeriod": "900s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM"}
                }
              },
              "plotType": "STACKED_BAR"
            }]
          }
        }
      },
      {
        "xPos": 6, "width": 6, "height": 4,
        "widget": {
          "title": "Eventos rechazados por calidad de datos",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/${rechazos}\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {"alignmentPeriod": "900s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM"}
                }
              },
              "plotType": "STACKED_BAR"
            }]
          }
        }
      },
      {
        "yPos": 4, "width": 6, "height": 4,
        "widget": {
          "title": "Latencia de la ingesta (p95)",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"ingesta\"",
                  "aggregation": {"alignmentPeriod": "900s", "perSeriesAligner": "ALIGN_PERCENTILE_95", "crossSeriesReducer": "REDUCE_MAX"}
                }
              },
              "plotType": "LINE"
            }]
          }
        }
      },
      {
        "xPos": 6, "yPos": 4, "width": 6, "height": 4,
        "widget": {
          "title": "Instancias activas de Cloud Run",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/container/instance_count\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {"alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_MAX", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["resource.label.\"service_name\""]}
                }
              },
              "plotType": "LINE"
            }]
          }
        }
      },
      {
        "yPos": 8, "width": 12, "height": 4,
        "widget": {
          "title": "Mensajes de Pub/Sub sin entregar a BigQuery",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"pubsub.googleapis.com/subscription/num_undelivered_messages\" resource.type=\"pubsub_subscription\"",
                  "aggregation": {"alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_MAX", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["resource.label.\"subscription_id\""]}
                }
              },
              "plotType": "LINE"
            }]
          }
        }
      }
    ]
  }
}
